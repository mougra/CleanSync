# Внутренний адрес Express API для серверных (SSR) запросов.
# Браузер всегда обращается к своему origin по пути /api — это обязательное
# условие работы httpOnly-cookie, поэтому публичной переменной здесь нет.
NUXT_API_BASE=http://localhost:5000

# Публичный адрес сайта: нужен i18n для абсолютных hreflang-ссылок.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
