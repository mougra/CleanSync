# Переменные для docker compose (прод-развёртывание).
#
#   cp .env.example .env   # и заполнить
#
# Отдельный от backend/.env файл нужен потому, что docker compose подставляет
# ${...} в docker-compose.yml именно отсюда (env_file сервиса backend в подстановке
# не участвует). Здесь — то, что относится к серверу и домену; секреты приложения
# (JWT, SMTP, VAPID, Sentry) живут в backend/.env.
#
# Локальная разработка этот файл не требует: у `docker compose up -d postgres`
# и у docker-compose.dev.yml свои значения по умолчанию.

# Публичный адрес сайта. ВАЖНО: читается НА СБОРКЕ образа web — от него зависят
# canonical, og:url, hreflang и адреса в карте сайта. Менять только вместе с
# пересборкой: docker compose up -d --build
SITE_URL=https://tidyplan.ru

# Домен для Caddy: на него выпускается сертификат Let's Encrypt и на него
# перенаправляется www. Без пробелов и без схемы.
SITE_DOMAIN=tidyplan.ru

# Доступ к базе. Должно совпадать с DB_* в backend/.env.
# Пароль базы задаётся ЗДЕСЬ и только здесь: том создаётся один раз, и смена
# POSTGRES_PASSWORD у уже созданного тома пароль внутри базы не меняет.
# Пароль идёт в DATABASE_URL, поэтому — только буквы и цифры: спецсимволы
# придётся URL-кодировать.
DB_USER=postgres
DB_PASSWORD=changemepostgres
DB_NAME=clean_planner

# Вариант деплоя без сборки на сервере (слабый VPS): образы собирает GitHub
# Actions и публикует в GHCR, сервер только скачивает их.
# Раскомментировать, если используете этот вариант.
# IMAGE_BACKEND=ghcr.io/mougra/cleansync-backend:latest
# IMAGE_WEB=ghcr.io/mougra/cleansync-web:latest
