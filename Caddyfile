# Домен приходит из переменной окружения SITE_DOMAIN (корневой .env), а не
# зашит в файл: так `git pull` на сервере не конфликтует с настройкой домена.
# В docker-compose.yml переменная передаётся сервису caddy.
# Если переменная не задана, подставляется localhost — сертификат будет
# локальным (внутренний CA Caddy), а не от Let's Encrypt.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# API обслуживает Express, остальное — Nuxt.
	# Внутри compose сервисы доступны по именам: backend и web.
	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy web:3000
	}

	# Заголовки безопасности для HTML отдаёт Nuxt; здесь добавляем только то,
	# что нужно на уровне прокси.
	#
	# HSTS: браузер запоминает домен как «только HTTPS» на год и сам переписывает
	# http:// на https:// до первого запроса — это закрывает окно, в котором
	# первый заход по http успевает уйти открытым текстом (важно и для cookie
	# с флагом Secure, и для service worker: он работает только в защищённом
	# контексте). `includeSubDomains` безопасен: единственный поддомен — www,
	# и он уже перенаправляется на основной адрес. `preload` не включаем:
	# это заявка в список браузеров, и снимать её потом долго.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# www уводим на основной адрес: canonical и карта сайта указывают на один хост,
# иначе поисковик видит две копии сайта. Для этого блока нужна DNS-запись www
# (A на тот же IP или CNAME на основной домен): без неё Caddy не выпустит
# сертификат на www и будет повторять попытки в логе, на основной домен это
# не влияет.
www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
