# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clean_planner

# Строка подключения для миграций (node-pg-migrate читает именно её).
# При смене DB_* выше обнови и её.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_planner

# JWT Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_key_change_this
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_this

# Email SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Clean Planner <noreply@example.com>"

# Server
PORT=5000
NODE_ENV=development

# Публичный адрес приложения: ссылки в письмах (подтверждение, сброс пароля)
APP_BASE_URL=http://localhost:3000
