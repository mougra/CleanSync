# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clean_planner

# JWT Secrets
ACCESS_TOKEN_SECRET=your_super_secret_access_key_change_this
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_this

# Email SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
