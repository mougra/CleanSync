# Сервер
PORT=5000
NODE_ENV=development

# Публичный адрес приложения: на него ведут ссылки в письмах
# (подтверждение почты и сброс пароля)
APP_BASE_URL=http://localhost:3000

# Безопасность и лимиты (см. backend/app.ts)
# CORS_ORIGINS — источники через запятую; пусто = кросс-доменные запросы запрещены,
# потому что приложение и API обязаны жить на одном origin (иначе httpOnly-cookie не отправится)
CORS_ORIGINS=
# За обратным прокси (Caddy/Traefik) поставить true, чтобы rate-limit видел реальные IP
TRUST_PROXY=false
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=30

# База данных
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clean_planner
# Строка для миграций (node-pg-migrate читает именно её)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clean_planner

# JWT: обязательно заменить в продакшене на длинные случайные строки
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Почта (SMTP). Пусто = письма не отправляются, ссылка пишется в лог сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="TidyPlan <noreply@example.com>"

# Web Push (напоминания о привычках). Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# Мониторинг ошибок (пусто = выключен). Для web — NUXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=
